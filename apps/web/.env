# These API keys are intentionally public. Please do not report them - thank you for your concern.
APP_ID=web
ALCHEMY_API_KEY="alchemy_api_key"
# HookSwap dedupe (2026-07): all *.uniswap.org backend hosts repointed to HookSwap's own
# data-api (data.hookswap.org) so nothing in the build references or calls uniswap.org.
# The general v2 REST (exploreStats/protocolStats/tokenRankings) is served by data-api.
API_BASE_URL_V2_OVERRIDE="https://data.hookswap.org/v2"
DATA_API_BASE_URL_V2_OVERRIDE="https://data.hookswap.org/v2"
# amplitude is disabled in code (apps/web/src/tracing/amplitude.ts); repointed off uniswap.org as defense.
AMPLITUDE_PROXY_URL="https://data.hookswap.org/v1/amplitude-proxy"
# GraphQL is disabled in code (apps/web/src/appGraphql/data/apollo/client.ts); repointed off uniswap.org as defense.
AWS_API_ENDPOINT="https://data.hookswap.org/v1/graphql"
# blockaid token-safety is a Uniswap service; repointed off uniswap.org (degrades gracefully to no-data).
BLOCKAID_PROXY_URL="https://data.hookswap.org/infra/blockaid"
INFURA_KEY="infura_api_key"
# jupiter is Solana-only (not used on HookSwap chains); repointed off uniswap.org.
JUPITER_PROXY_URL="https://data.hookswap.org/jupiter"
PRIVY_APP_ID="privy_app_id"
PRIVY_CLIENT_ID="privy_client_id"
QUICKNODE_ENDPOINT_NAME="tame-frequent-fog"
QUICKNODE_ENDPOINT_TOKEN="quicknode_endpoint_token"
QUICKNODE_AVAX_RPC_URL="quicknode_avax_rpc_url"
QUICKNODE_BASE_RPC_URL="quicknode_base_rpc_url"
QUICKNODE_BLAST_RPC_URL="quicknode_blast_rpc_url"
QUICKNODE_BNB_RPC_URL="quicknode_bnb_rpc_url"
QUICKNODE_CELO_RPC_URL="quicknode_celo_rpc_url"
QUICKNODE_OP_RPC_URL="quicknode_op_rpc_url"
QUICKNODE_POLYGON_RPC_URL="quicknode_polygon_rpc_url"
SENTRY_ENABLED="false"
STATSIG_API_KEY="statsig_api_key"
STATSIG_PROXY_URL="https://interface.gateway.uniswap.org/v1/statsig-proxy"
TRADING_API_KEY="trading_api_key"
TRADING_API_URL_OVERRIDE="https://trading.hookswap.org"
UNISWAP_API_KEY="uniswap_api_key"
# Legacy classic-swap routing base (the Terminal routes through trading.hookswap.org instead);
# repointed off uniswap.org so the legacy path can never quote against Uniswap's gateway.
UNISWAP_GATEWAY_DNS="https://trading.hookswap.org/v2"
WALLETCONNECT_PROJECT_ID="walletconnect_project_id"
