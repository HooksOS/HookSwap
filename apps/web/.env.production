REACT_APP_JUPITER_PROXY_URL="https://data.hookswap.org/jupiter"
# REDACTED 2026-07-25: a real Infura key was committed here. Provider keys must never be
# committed — supply them via the gitignored apps/web/.env.local (which outranks this file
# in Vite's loadEnv). The build box already sets INFURA_KEY there. Same rule for
# ALCHEMY_API_KEY. NOTE: the old value is still in git history — rotate it at infura.io.
REACT_APP_INFURA_KEY=""
REACT_APP_ANALYTICS_ENABLED=true
VITE_ENABLE_ENTRY_GATEWAY_PROXY=false
