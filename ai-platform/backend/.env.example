# ============================================================================
# HookSwap AI Knowledge Platform — backend env. Copy to .env and fill in.
# All keys are read by app/core/config.py (pydantic-settings, prefix HOOKSWAP_AI_).
# ============================================================================

# --- app ---
HOOKSWAP_AI_ENV=development                 # development | staging | production
HOOKSWAP_AI_DEBUG=true
HOOKSWAP_AI_LOG_LEVEL=INFO
HOOKSWAP_AI_LOG_JSON=false
HOOKSWAP_AI_API_PREFIX=/api/v1
HOOKSWAP_AI_CORS_ORIGINS=http://localhost:3000,https://hookswap.org

# --- security ---
HOOKSWAP_AI_JWT_SECRET=change-me-in-prod-please-32b-min
HOOKSWAP_AI_JWT_ALGORITHM=HS256
HOOKSWAP_AI_JWT_TTL_SECONDS=3600
HOOKSWAP_AI_API_KEY_PREFIX=hsk_

# --- postgres (async) ---
HOOKSWAP_AI_DATABASE_URL=postgresql+asyncpg://hookswap:hookswap@localhost:5432/hookswap_ai
HOOKSWAP_AI_DB_POOL_SIZE=10
HOOKSWAP_AI_DB_MAX_OVERFLOW=20
HOOKSWAP_AI_DB_ECHO=false

# --- redis ---
HOOKSWAP_AI_REDIS_URL=redis://localhost:6379/0

# --- qdrant (vector store) ---
HOOKSWAP_AI_VECTORSTORE_PROVIDER=qdrant      # qdrant | pinecone | milvus | weaviate
HOOKSWAP_AI_QDRANT_URL=http://localhost:6333
HOOKSWAP_AI_QDRANT_API_KEY=
HOOKSWAP_AI_QDRANT_COLLECTION=hookswap_knowledge

# --- opensearch (BM25 / hybrid) ---
HOOKSWAP_AI_OPENSEARCH_URL=http://localhost:9200
HOOKSWAP_AI_OPENSEARCH_INDEX=hookswap_chunks
HOOKSWAP_AI_OPENSEARCH_USER=
HOOKSWAP_AI_OPENSEARCH_PASSWORD=

# --- embeddings ---
HOOKSWAP_AI_EMBEDDING_PROVIDER=openai        # openai | voyage | bge | nomic
HOOKSWAP_AI_EMBEDDING_MODEL=text-embedding-3-large
HOOKSWAP_AI_EMBEDDING_DIM=3072
HOOKSWAP_AI_OPENAI_API_KEY=
HOOKSWAP_AI_VOYAGE_API_KEY=
HOOKSWAP_AI_NOMIC_API_KEY=

# --- llm providers ---
HOOKSWAP_AI_LLM_DEFAULT_PROVIDER=anthropic   # openai | anthropic | gemini | openrouter | ollama
HOOKSWAP_AI_ANTHROPIC_API_KEY=
HOOKSWAP_AI_GEMINI_API_KEY=
HOOKSWAP_AI_OPENROUTER_API_KEY=
HOOKSWAP_AI_OLLAMA_BASE_URL=http://localhost:11434

# --- rag tuning ---
HOOKSWAP_AI_RAG_TOP_K=8
HOOKSWAP_AI_RAG_FETCH_K=32
HOOKSWAP_AI_RAG_CONTEXT_TOKEN_BUDGET=6000
HOOKSWAP_AI_RAG_MIN_CONFIDENCE=0.35
HOOKSWAP_AI_RAG_RERANK_ENABLED=true

# --- live data tools (HookSwap DEX data-api + chain indexer) ---
HOOKSWAP_AI_DATA_API_BASE_URL=https://data.hookswap.org
HOOKSWAP_AI_TRADING_API_BASE_URL=https://trading.hookswap.org

# --- rate limiting ---
HOOKSWAP_AI_RATE_LIMIT_DEFAULT_PER_MIN=60
