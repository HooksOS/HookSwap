# ── HookSwap AI Platform frontend ──────────────────────────────────────────
# Public base URL of the FastAPI backend (REST + GraphQL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# WebSocket base for streaming chat / job events.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# GraphQL endpoint (defaults to $API_BASE_URL/graphql if unset).
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql

# Optional server-side proxy target (used by next.config rewrites → /api/backend/*)
BACKEND_INTERNAL_URL=http://backend:8000

# WalletConnect (wagmi) — required for WalletConnect connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Feature flags
NEXT_PUBLIC_ENABLE_ADMIN=true
