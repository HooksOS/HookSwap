# HookSwapPerps counterparty bot — copy to .env, fill BOT_PRIVATE_KEY + MARKET.
# NEVER commit the real .env (it holds the bot's private key). See .gitignore.

# The bot's own wallet (fresh key, funded once from the deployer). 0x + 64 hex.
BOT_PRIVATE_KEY=

# Target perp market address (the oracle-wired ETH-PERP market the UI trades).
MARKET=

# Engine + chain.
ENGINE_URL=https://perps.hookswap.org
SEPOLIA_RPC_URL=https://sepolia.drpc.org
PERPS_CHAIN_ID=11155111

# Chainlink ETH/USD (Sepolia) — the live mark source.
CHAINLINK_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306

# Quote shape (defaults shown).
BOT_SIZE=2000000000000000        # 0.002e18
BOT_LEVERAGE_X=2
BOT_SPREAD_BPS=10                # 0.10% off mark per side (H-1 band is 5%)
BOT_LOOP_MS=30000
BOT_ORDER_TTL=600

# Collateral management.
BOT_DEPOSIT_ETH=0.03
BOT_MIN_AVAILABLE=0.004
BOT_TOPUP_ETH=0.01
