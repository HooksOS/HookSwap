[Unit]
Description=HookSwapPerps counterparty bot (Sepolia) — rests a two-sided quote so a solo UI user gets a real fill
After=network-online.target hookswap-perps-engine.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hookswap-perps-engine
EnvironmentFile=/home/ubuntu/hookswap-perps-engine/bot/.env
ExecStart=/home/ubuntu/hookswap-perps-engine/node_modules/.bin/tsx bot/bot.ts
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/hookswap-perps-engine/bot/bot.log
StandardError=append:/home/ubuntu/hookswap-perps-engine/bot/bot.log

[Install]
WantedBy=multi-user.target
