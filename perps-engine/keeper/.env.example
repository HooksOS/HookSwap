# HookSwapPerps keeper config. Copy to keeper/.env on the VPS (chmod 600).
# Keeper keys are read once and NEVER logged. Use DEDICATED keys — separate from the
# engine matcher / counterparty bot — so keeper txs never collide nonces.
#
# MULTI-CHAIN: the keeper sweeps EVERY chain in config/chains.json (or PERPS_CHAINS_CONFIG),
# using each entry's `keeperKeyEnv` to find that chain's key. The vars below are the
# BACKWARD-COMPAT single-chain fallback used only when NO chains config is present.
#
# For the 2-chain (Sepolia + Robinhood) setup, config/chains.json names:
#   KEEPER_PRIVATE_KEY      -> Sepolia (11155111) keeper key
#   RH_KEEPER_PRIVATE_KEY   -> Robinhood (4663) keeper key
# Set both here (0x-prefixed 32-byte hex). A chain whose key is empty is skipped.
KEEPER_PRIVATE_KEY=
RH_KEEPER_PRIVATE_KEY=

# Optional RPC overrides (else the chains.json literal / public default is used).
SEPOLIA_RPC_URL=https://sepolia.drpc.org
SEPOLIA_RPC_FALLBACK=https://1rpc.io/sepolia
# RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Legacy single-chain fallback (only used when config/chains.json is ABSENT) ---
PERPS_CHAIN_ID=11155111
MARKET_REGISTRY=0xEDE278469694e951676973B7b9e193a98463DAC2
ORACLE_GUARD=0x3D2ee857AE129688fA43E378dAE85b60803bfFD1
# KEEPER_GAS_MODE=legacy   # legacy|eip1559 for the synthesized fallback chain

# Loop cadences (ms).
KEEPER_LIQ_LOOP_MS=25000
KEEPER_FUNDING_LOOP_MS=60000
KEEPER_MARKET_REFRESH_MS=120000

# Mark-refresh policy: refresh the on-chain mark only when it is 0 or drifts beyond
# this many bps from the Chainlink reference. Keep well inside the OracleGuard band
# (500 bps here) so a valid in-band mark always exists for canLiquidate.
KEEPER_MARK_REFRESH_BPS=400

# Legacy gas price (wei) for Sepolia.
KEEPER_GAS_PRICE_WEI=2000000000

# Funding settleFundingBatch batch size.
KEEPER_FUNDING_BATCH=50

# Optional: restrict to specific market addresses (comma-separated). Empty = all.
KEEPER_ONLY_MARKETS=

# Optional: JSON results snapshot path.
KEEPER_RESULTS_FILE=/home/ubuntu/hookswap-perps-engine/keeper/keeper-results.json
