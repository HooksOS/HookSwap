# HookSwap data-api — environment
# Copy to `.env` and adjust. All values have safe defaults (see src/chains.ts) except the ones you
# want to harden (CORS origin).

# Port the Connect-RPC server binds. Default 4092 (distinct from the trading adapter's 4090).
PORT=4092

# Strict CORS allowlist — comma-separated EXACT origins (no trailing slash). The browser calls this
# with credentials, so only exact-match origins get Access-Control-Allow-Credentials. Never use "*"
# in production (it disables credentialed responses).
CORS_ALLOW_ORIGIN=https://hookswap.org

# --- Per-chain RPC overrides (OPTIONAL — leave unset to use the built-in lists) ---
#
# PUBLIC RPCs ONLY. NO ALCHEMY, NO HOSTED KEYS (Reggie, 2026-08-02: the single Alchemy key went over
# quota and returned HTTP 429 on every chain at once, taking all chain reads down).
#
# Each WEB3_RPC_<chainId> accepts EITHER one URL or a COMMA-SEPARATED, ORDERED list of up to ~5
# endpoints. Requests try index 0, fail over to the next on error, and wrap around; a failing endpoint
# is skipped for a 60s cooldown. See src/rpc.ts for the failover contract.
#
# You normally do NOT need to set these at all: src/chains.ts already carries the ordered, live-tested
# public list for every chain. Only set one to PIN a chain to a specific endpoint (e.g. a dedicated
# node you have provisioned) — and remember that doing so REPLACES the built-in list, so include your
# fallbacks in the same comma-separated value.
#
# ⛔ NEVER put any of these in a WEB3_RPC_* value (they answer HTTP 200 with WRONG data and are
#    hard-filtered by src/rpc.ts BLACKLISTED_RPCS anyway):
#      https://megaeth.blockscout.com/api/eth-rpc          (silently drops logs, caps at 1000)
#      https://robinhood.drpc.org                          ("does not exist" on every method but eth_chainId)
#      https://robinhoodchain.blockscout.com/api/eth-rpc   (HTTP 429 as result:null, no error field)
#      https://ethereum-sepolia-rpc.publicnode.com         (403 on eth_getLogs / archive eth_call)
#
# IMPORTANT: keep values on their own line with NO trailing inline comment. systemd's
# EnvironmentFile does NOT strip inline `# ...` (unlike dotenv), so `URL   # note` becomes part of
# the URL and breaks the provider. (Learned the hard way on the trading adapter — CLAUDE.md.)

# Robinhood (4663) — ONLY ONE public endpoint works; there is no failover on this chain.
# WEB3_RPC_4663=https://rpc.mainnet.chain.robinhood.com

# MegaETH (4326)
# WEB3_RPC_4326=https://mainnet.megaeth.com/rpc,https://megaeth.drpc.org,https://4326.rpc.thirdweb.com

# Ink (57073)
# WEB3_RPC_57073=https://ink.gateway.tenderly.co,https://rpc-qnd.inkonchain.com,https://ink.drpc.org,https://rpc-gel.inkonchain.com,https://57073.rpc.thirdweb.com

# XLayer (196) — the last two cap eth_getLogs at 100 blocks, hence the order.
# WEB3_RPC_196=https://xlayer.drpc.org,https://196.rpc.thirdweb.com,https://rpc.xlayer.tech,https://xlayerrpc.okx.com

# HyperEVM (999) — the OFFICIAL endpoint is last on purpose (it rate-limits aggressively).
# WEB3_RPC_999=https://hyperliquid.drpc.org,https://rpc.hyperlend.finance,https://hyperliquid.rpc.blxrbdn.com,https://hyperliquid-json-rpc.stakely.io,https://999.rpc.thirdweb.com,https://rpc.hyperliquid.xyz/evm

# Stable (988) — the last two cap eth_getLogs at 500 blocks.
# WEB3_RPC_988=https://stable-mainnet.rpc.sentio.xyz,https://rpc.stable.xyz,https://stable.drpc.org

# Tempo (4217)
# WEB3_RPC_4217=https://rpc.tempo.xyz,https://rpc.mainnet.tempo.xyz,https://tempo.drpc.org

# Sepolia (11155111)
# WEB3_RPC_11155111=https://sepolia.drpc.org,https://sepolia.gateway.tenderly.co,https://11155111.rpc.thirdweb.com

# ============================================================================================
# eth_getLogs BUDGET (src/rpc.ts) — per-chain token bucket, `eth_getLogs` ONLY
# ============================================================================================
# Robinhood (4663) has ONE working public RPC and weights eth_getLogs far more heavily than cheap
# reads. Measured live 2026-08-03 against rpc.mainnet.chain.robinhood.com:
#   400 sequential eth_blockNumber @ 9.2 req/s  -> no limit hit
#   80 CONCURRENT eth_blockNumber               -> no limit hit
#   13 sequential eth_getLogs (2000-blk windows)-> HTTP 429 Too Many Requests
# i.e. ~12 getLogs per 60s, SHARED with locker-indexer + perps-engine/bot/keeper. data-api's v3 scan
# used to spend up to 190 per cache miss, which starved all of them.
#
# Defaults (no env needed): chain 4663 = 8 per 60s, every other chain = 60 per 60s.
# Cheap methods (eth_call / eth_blockNumber / eth_getBalance / ...) are NEVER budgeted.
#
# GETLOGS_BUDGET_<chainId>      calls per window for one chain. 0 = DISABLE the budget for it.
# GETLOGS_BUDGET_DEFAULT        calls per window for chains with no specific entry (default 60).
# GETLOGS_WINDOW_MS_<chainId>   window length in ms for one chain (default 60000).
# GETLOGS_WINDOW_MS_DEFAULT     window length in ms for all other chains (default 60000).
# GETLOGS_BUDGET_4663=8

# --- v3 PoolCreated scan bounds (src/onchain.ts) ---
# The scan is INCREMENTAL + RESUMABLE (cursor in SQLite `scan_cursor`), so it no longer needs to cover
# its whole span in one pass. Keep V3_MAX_CHUNKS at or below the chain's getLogs budget.
# V3_MAX_CHUNKS_<chainId> / V3_MAX_CHUNKS   getLogs windows per pass (default 6)
# V3_LOG_CHUNK_<chainId>  / V3_LOG_CHUNK    blocks per window (default 2000, capped at 2000)
# V3_MAX_CHUNKS_4663=6
