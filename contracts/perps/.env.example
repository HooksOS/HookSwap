# ============================================================
# HookSwapPerps — deploy env (Sepolia FIRST)
# ============================================================
# NEVER commit a real private key. This file ships PLACEHOLDERS only.
# The deployer key is supplied at runtime by Reggie (funded wallet) —
# see README.md "What needs Reggie's funded key".

# Deployer key — DO NOT COMMIT A REAL VALUE. Pass via `--private-key` or a
# gitignored .env that is never staged.
PRIVATE_KEY=

# --- RPC endpoints ---
# Sepolia is the mandatory first target (chainId 11155111).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
MEGAETH_RPC_URL=
INK_RPC_URL=
XLAYER_RPC_URL=
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
TEMPO_RPC_URL=

# --- Verification ---
ETHERSCAN_API_KEY=

# --- Deploy parameters (optional; DeployPerps reads config/<chain>.json first, then env) ---
# The off-chain matching-engine relayer address that is authorized to settle batches.
# ⚠️ This is a PUBLIC address, never a private key.
MATCHER_ADDRESS=
# Fee receiver (defaults to deployer if unset).
FEE_RECEIVER_ADDRESS=
# WETH used as the ETH-denominated collateral. Sepolia canonical WETH is baked into config/sepolia.json.
WETH_ADDRESS=
